# Reference file only. Spring Boot does not load it automatically.
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
SERVER_FORWARD_HEADERS_STRATEGY=none

DB_URL=jdbc:postgresql://localhost:5432/inventory_db
DB_USERNAME=inventory_user
DB_PASSWORD=replace_with_local_password

JWT_SECRET=replace_with_a_secret_of_at_least_32_characters
JWT_EXPIRATION_MS=86400000
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_USER=10
LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=30
LOGIN_RATE_LIMIT_MAX_TRACKED_KEYS=10000

# Available only with SPRING_PROFILES_ACTIVE=dev. There are no default credentials.
DEV_ADMIN_USERNAME=admin.local
DEV_ADMIN_PASSWORD=replace_with_a_local_password_of_at_least_12_characters
DEV_ADMIN_NAME=Local Administrator
DEV_ADMIN_EMAIL=

# Development-only Hibernate diagnostics. Keep the defaults for normal use.
# TRACE bind logging can include sensitive values; enable it only temporarily and review logs before sharing them.
DEV_HIBERNATE_SQL_LOG_LEVEL=ERROR
DEV_HIBERNATE_BIND_LOG_LEVEL=ERROR
